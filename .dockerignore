.git
.github
*.md
!README.md
.gitignore
.dockerignore
/runner-manager
/runner-agent
*.exe
runners
config/config.yaml
.env
*.test
*.out
.DS_Store
# Custom runner image examples are not part of these builds
examples

# Paths both images need, included explicitly so later rules cannot drop them
!cmd
!cmd/**
# The Manager image also needs internal, the config template and scripts
!internal
!internal/**
!config.yaml.example
!scripts
!scripts/**
