# Copy to .env and edit
#   cp .env.example .env
#
# Full reference: docs/guide.md, "Environment variables" in section 2
#
# Copy-and-go deployments for both shapes (single container / multi container): examples/deploy/
#
# docker-compose reads .env. Everything below is optional.

# === Images ===
#
# Manager image, matching runner-manager.image in docker-compose.
# Production: pin a version. Development: MANAGER_IMAGE=ghcr.io/sharkpaw/runner-deck:main
# MANAGER_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.0.0
#
# Runner image when config/config.yaml does not set container_image. Derived from MANAGER_IMAGE
# first (v2.0.0 -> v2.0.0-runner), else decided by FLEET_IMAGE_TAG.
# RUNNER_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.0.0-runner
# CONTAINER_IMAGE=                 # alias of RUNNER_IMAGE; set last, it wins
# FLEET_IMAGE_TAG=main             # tag used when neither of the above is set

# === Ports ===
#
# MANAGER_PORT is the published port, SERVER_PORT the one inside the container. docker-compose
# pins SERVER_PORT and maps MANAGER_PORT onto it, so the two may differ.
# Without compose, `docker run` also lets MANAGER_PORT override server.port — either leave it
# unset and use -p alone, or make -p's container side match it.
# MANAGER_PORT=8080
# SERVER_PORT=8080
# SERVER_ADDR=0.0.0.0              # empty = all interfaces

# === Docker ===
#
# Which Docker daemon the Manager itself uses. Container mode requires the host socket —
# do not point this at DinD, or creating runner containers fails.
# Using job_docker_backend: dind? Start DinD first: docker compose --profile dind up -d
# DOCKER_HOST=tcp://runner-dind:2375
#
# Host docker group GID. Needed when it is not 999, both for the Manager (to reach docker.sock)
# and, under job_docker_backend=host-socket, to --group-add it onto runner containers.
# Empty means the Manager detects it from /var/run/docker.sock. Check with:
#   getent group docker | cut -d: -f3
# DOCKER_GID=113

# === Auth ===
#
# Setting BASIC_AUTH_PASSWORD enables Basic Auth on the UI and API. GET /health and GET /ready
# stay unauthenticated either way.
# BASIC_AUTH_USER=admin            # optional, defaults to admin
# BASIC_AUTH_PASSWORD=
#
# Cross-site writes (POST/PUT/DELETE) are refused by default and need no configuration. This is
# only for a reverse proxy that rewrites Host and makes your own requests look cross-site: list
# the origins as the browser's address bar shows them, comma-separated, and only ones you control.
# TRUSTED_ORIGINS=https://ci.example.com

# === Overrides for config/config.yaml ===
#
# A full-container deployment can change shape from .env alone, without editing config/config.yaml.
#
# CONTAINER_MODE only turns container mode ON — it can never turn it off, so one stray value
# cannot silently change a deployment's shape.
# CONTAINER_MODE=true
# CONTAINER_NETWORK=runner-net
# JOB_DOCKER_BACKEND=host-socket   # dind | host-socket | none
# VOLUME_HOST_PATH=/root/runners   # absolute path of runners on the host, e.g. realpath runners
# RUNNERS_VOLUME_HOST_PATH=        # alias of VOLUME_HOST_PATH; set last, it wins
# RUNNERS_BASE_PATH=/app/runners   # usually /app/runners inside the container

# === Logging ===
#
# console is for people; set json when shipping to ELK, Loki and friends. An unrecognized value
# falls back to console rather than failing startup.
# LOG_FORMAT=console               # console | json
# LOG_LEVEL=info                   # trace | debug | info | warn | error
