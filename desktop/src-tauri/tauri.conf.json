{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runner Deck",
  "version": "0.2.0",
  "identifier": "com.sharkpaw.runnerdeck",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "sh scripts/build-manager.sh",
    "beforeDevCommand": "sh scripts/build-manager.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/runner-manager"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "12.0" }
  }
}
