# Runner image: the Agent and runtime dependencies. The Manager mounts /runner, so the Agent
# lives in /app where the mount cannot hide the entrypoint.
ARG BUILDPLATFORM
FROM --platform=$BUILDPLATFORM golang:1.27.3-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/runner-agent ./cmd/runner-agent
# The Agent imports internal/runnerproc, so all of internal is copied. Naming only that package
# would break this build the next time the Agent imports another one, and a full checkout would
# not show it until the image is published.
COPY internal ./internal
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o runner-agent ./cmd/runner-agent

FROM ubuntu:24.04
LABEL org.opencontainers.image.title="Runner Deck Runner" \
      org.opencontainers.image.description="Single GitHub Actions runner container with an Agent the Manager controls"

# The package list lives in scripts/apt-packages.txt, shared by the Manager and Runner images.
COPY scripts/apt-packages.txt /tmp/apt-packages.txt
RUN apt-get update \
    && awk '!/^[[:space:]]*#/ && NF' /tmp/apt-packages.txt \
       | xargs -r apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-packages.txt
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod 644 /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# When jobs use Docker through the host's docker.sock, app (UID 1001) must be in the socket's group, or they get
# "permission denied while trying to connect to the Docker daemon socket"。
# Defaults to 999, the usual docker GID on Debian and Ubuntu; override with
# --build-arg DOCKER_GID=<host GID>. Runner containers created by the Manager also get
# --group-add with the socket's real GID, so no rebuild is needed for that.
ARG DOCKER_GID=999
RUN groupadd -g 1001 app && useradd -r -u 1001 -g app -d /runner -s /bin/bash app \
    && if ! getent group "${DOCKER_GID}" >/dev/null; then groupadd -g "${DOCKER_GID}" docker; fi \
    && usermod -aG "$(getent group "${DOCKER_GID}" | cut -d: -f1)" app
# Hosted runners offer passwordless sudo and many workflows call `sudo apt-get install -y ...`.
# Installing sudo without sudoers would leave a command that exists but cannot be used.
# Turn it off with --build-arg ALLOW_SUDO=false when you need a stricter boundary.
#
# This does not really widen what a job can do: app already owns the work directory. The real
# boundary is the container (use runners.resources in container mode) and whether the host's
# docker.sock is mounted.
ARG ALLOW_SUDO=true
RUN if [ "${ALLOW_SUDO}" = "true" ]; then \
        echo "app ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/runner-deck-app \
        && chmod 0440 /etc/sudoers.d/runner-deck-app \
        && visudo -c -f /etc/sudoers.d/runner-deck-app; \
    fi

# tini as PID 1 does two things the Go process cannot. It reaps orphans: `cmd &` in a job,
# daemonized tools and the Gradle daemon get handed to PID 1, and Go only waits for the child it
# started, so the rest become zombies. Runners live long, so zombies pile up across jobs and use
# up runners.resources.pids_limit, until fork fails with "Resource temporarily unavailable".
# It also forwards SIGTERM to the direct child.
# Not listed in scripts/apt-packages.txt: that list mirrors the tools jobs get from
# actions/runner-images, while tini is part of the runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*

RUN install -m 0755 -d /app && install -m 0755 -d /runner
COPY --from=builder /app/runner-agent /app/runner-agent
RUN chown app:app /app/runner-agent /runner

WORKDIR /runner
ENV RUNNER_INSTALL_DIR=/runner
ENV AGENT_PORT=8081

USER app
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8081/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/app/runner-agent"]
