# Example Runner image for Node.js.
#
# Build:
#   make docker-build-runner-example EXAMPLE=node IMAGE=your-registry/node-runner:1
#
# Override the version with --build-arg NODE_MAJOR=22. See README.md in the same directory.
#
# If the workflow already pins a version with actions/setup-node, this image is usually unnecessary —
# setup-node downloads and caches to _work/_tool on its own. Preinstalling saves a download on every run,
# and lets workflows without setup-node run directly.

ARG RUNNER_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.0.0-runner
FROM ${RUNNER_IMAGE}

ARG NODE_MAJOR=22

USER root

RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && chmod 644 /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Move the npm cache explicitly out of $HOME and make it owned by app, otherwise the first npm install fails for lack of permission.
#
# This is /home/app/.npm rather than the default $HOME/.npm, because in container mode app's HOME is /runner
# — the Manager mounts a host directory here when creating the container; putting the cache there would make one copy per Runner,
# and consume space in the host's Runner directory. /home/app is outside the mount point and lives in the image layers, so on the same daemon
# all Runner containers share that one copy (overlayfs), and Job writes use copy-on-write so they don't contaminate each other —
# the same approach as sharing the toolchain cache in examples/deploy/fleet/Dockerfile.runner-cached.
# Don't 'tidy up' by changing it back to $HOME/.npm.
ENV NPM_CONFIG_CACHE=/home/app/.npm
RUN install -d -o 1001 -g 1001 /home/app/.npm

USER app
RUN node --version && npm --version
