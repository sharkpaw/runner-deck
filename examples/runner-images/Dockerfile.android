# Example Runner image for Android SDK + Flutter.
#
# Build:
#   make docker-build-runner-example EXAMPLE=android IMAGE=your-registry/android-runner:1
#   docker build -f examples/runner-images/Dockerfile.android -t your-registry/android-runner:1 .
#
# Override versions per project with --build-arg, for example:
#   --build-arg ANDROID_PLATFORM=android-34 --build-arg FLUTTER_VERSION=3.32.0
#
# See README.md in the same directory. The base image already includes git/unzip/xz-utils/build-essential, etc.,
# This file only adds the large, project-specific toolchains: Android and Flutter.

ARG RUNNER_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.1.0-runner
FROM ${RUNNER_IMAGE}

ARG ANDROID_CMDLINE_TOOLS=11076708
ARG ANDROID_PLATFORM=android-35
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG FLUTTER_VERSION=3.38.4

USER root

# Android SDK: cmdline-tools must sit under cmdline-tools/latest for sdkmanager to recognize it.
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}
RUN install -d "${ANDROID_HOME}/cmdline-tools" \
    && curl -fsSL -o /tmp/cmdline-tools.zip \
       "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" \
    && unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools" \
    && mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm -f /tmp/cmdline-tools.zip

ENV PATH="${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools"

# Java is provided by the workflow's setup-java; sdkmanager itself needs a JRE, so install the headless build here.
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

RUN yes | sdkmanager --licenses > /dev/null \
    && sdkmanager --install "platform-tools" "platforms;${ANDROID_PLATFORM}" "build-tools;${ANDROID_BUILD_TOOLS}"

# The Flutter SDK is itself a git repo, and the flutter command calls git to read the version and channel.
ENV FLUTTER_HOME=/opt/flutter
RUN git clone --depth 1 --branch "${FLUTTER_VERSION}" \
       https://github.com/flutter/flutter.git "${FLUTTER_HOME}"
ENV PATH="${PATH}:${FLUTTER_HOME}/bin"

# The container runs as UID 1001, and both of these directories are written to during the Job (license markers, caches, downloaded components).
RUN chown -R 1001:1001 "${ANDROID_HOME}" "${FLUTTER_HOME}"

# safe.directory goes in --system (/etc/gitconfig), not --global.
# --global writes $HOME/.gitconfig, but in container mode the app's HOME is /runner. The Manager
# mounts the host directory exactly here when it creates the container, so the .gitconfig baked into the image gets overwritten in every Job,
# making the write pointless. /etc/gitconfig is outside the mount point, so it actually persists.
#
# This line is effectively unused at build time (after switching to app below, FLUTTER_HOME is already chowned to 1001,
# so the owner matches the euid and git won't report dubious ownership). It's for Jobs that run flutter as root,
# since the base image ships with passwordless sudo, and usages like `sudo -i` that drop SUDO_UID
# cause git to reject this repo owned by 1001.
RUN git config --system --add safe.directory "${FLUTTER_HOME}"

USER app

# Warm-up must happen after switching back to app, otherwise the output stays owned by root.
# Output lands in ${FLUTTER_HOME}/bin/cache (under /opt, outside the mount point, shared by all Jobs);
# while flutter pub get in a Job fetches packages into $PUB_CACHE, which defaults to $HOME/.pub-cache = /runner/.pub-cache,
# In the mount point, one copy per Runner; image prewarming won't reach it. To share it, set ENV PUB_CACHE explicitly to a path under /opt.
RUN flutter precache --android \
    && flutter --version
