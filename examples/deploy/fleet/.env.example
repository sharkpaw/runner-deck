# One container per runner: shared image and toolchain caches, isolated build caches.
# Usage: cp .env.example .env, change the two values marked REQUIRED, then follow README.md.

MANAGER_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.1.0

# Host address and port. The container side is SERVER_PORT; compose maps one onto the other.
# 8080, 9000 or 127.0.0.1:8090 all work. Keep the 127.0.0.1 prefix for local access only.
MANAGER_PORT=127.0.0.1:8090
SERVER_PORT=8080
SERVER_ADDR=0.0.0.0

BASIC_AUTH_USER=admin
# Empty disables auth (GET /health never needs it). Required when exposed to the internet.
BASIC_AUTH_PASSWORD=

# Each runner gets a container with HOME=/runner, which is ${VOLUME_HOST_PATH}/<runner name> on
# the host, so _work and ~/.gradle, ~/.m2, ~/.npm and ~/.cache stay separate per runner.
CONTAINER_MODE=true
RUNNERS_BASE_PATH=/app/runners
CONTAINER_NETWORK=runner-net

# REQUIRED: absolute host path of the runners directory (realpath runners).
# A wrong value raises no error: runners mount an empty directory and stay "new".
VOLUME_HOST_PATH=/absolute/path/to/examples/deploy/fleet/runners

# Jobs share the host daemon, so image layers and BuildKit cache are shared.
# host-socket only works with CONTAINER_MODE=true and gives jobs full control of the host daemon;
# use it only with trusted repositories. For stronger isolation set JOB_DOCKER_BACKEND=dind and run
# docker compose --profile dind up -d. Existing containers keep the backend they were created with.
JOB_DOCKER_BACKEND=host-socket

# REQUIRED, check it: getent group docker | cut -d: -f3
# Used for the Manager's group_add and for --group-add on runner containers.
DOCKER_GID=999

# Runner image with shared toolchain and action caches, built from Dockerfile.runner-cached by
# docker compose --profile build build runner-image.
RUNNER_IMAGE=local/runner-deck-cached:v2.1.0-runner
RUNNER_BASE_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.1.0-runner
NODE_VERSION=22.14.0

# Do not set DOCKER_HOST: container mode needs the host's unix socket to manage runner containers.
