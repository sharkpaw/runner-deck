# Shared-cache Runner image.
#
# Why the cache is baked into the image: in container mode, Manager mounts only
# <VOLUME_HOST_PATH>/<name>:/runner (plus docker.sock under host-socket) when it creates a Runner container; there is no option for extra mounts.
# On one Docker daemon, image layers are stored once across all Runner containers (overlayfs),
# and a Job's writes use copy-on-write, so the cache is physically shared while writes don't affect each other.
#
# Build: docker compose --profile build build runner-image
# After changing the cache contents, rebuild the image; no need to delete containers by hand. A same-tag rebuild gets a new image ID,
# and Manager compares image IDs. Stopped Runners are rebuilt automatically on their next start; running ones are flagged
# "config changed", and clicking "rebuild container" on that row applies it now (this interrupts any Job in progress).
#
# For extending languages and platform SDKs (Android, Flutter, etc.), see ../../runner-images/.

ARG RUNNER_BASE_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.0.0-runner
FROM ${RUNNER_BASE_IMAGE}

USER root

# ============ Shared toolchain cache (biggest payoff) ============
# The layout must be <tool>/<version>/<arch>, with an empty <arch>.complete file alongside,
# otherwise actions/setup-* won't recognize it and will re-download (@actions/tool-cache looks up this path).
# Node is the example below; Python, Go, and Java work the same way. Just swap the tool name and extraction path.
ARG NODE_VERSION=22.14.0
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64)  arch=x64 ;; \
      aarch64) arch=arm64 ;; \
      *) echo "unsupported arch: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    dir="/opt/hostedtoolcache/node/${NODE_VERSION}"; \
    mkdir -p "$dir"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.gz" \
      | tar xz -C "$dir"; \
    mv "$dir/node-v${NODE_VERSION}-linux-${arch}" "$dir/$arch"; \
    test -x "$dir/$arch/bin/node"; \
    touch "$dir/$arch.complete"

# ============ Shared action archive cache (optional, small payoff) ============
# Directory format: <owner>_<repo>/<commit-sha>.tar.gz, containing the GitHub repo tarball (with one nested directory).
# This only hits reliably when the workflow pins the action to a commit sha; with tags like @v4, the sha drifts.
# A single action is usually only a few hundred KB, so don't over-engineer it. Do the toolchain cache above first.
RUN mkdir -p /opt/actions-cache
# Example (replace <sha>, then uncomment):
# RUN mkdir -p /opt/actions-cache/actions_checkout \
#  && curl -fsSL -o /opt/actions-cache/actions_checkout/<sha>.tar.gz \
#        https://api.github.com/repos/actions/checkout/tarball/<sha>

# Inside the container, Jobs run as app (UID 1001)
RUN chown -R 1001:1001 /opt/hostedtoolcache /opt/actions-cache

# Put the cache location in the image environment: the Agent launches run.sh with this environment, Runner.Listener inherits it and passes it to the Job,
# so there is no need to place a separate .env file in each Runner directory.
ENV RUNNER_TOOL_CACHE=/opt/hostedtoolcache
ENV ACTIONS_RUNNER_ACTION_ARCHIVE_CACHE=/opt/actions-cache

# Do not set ACTIONS_RUNNER_SYMLINK_CACHED_ACTIONS=true:
# it turns _work/_actions/<action> into symlinks to the shared directory, so any write into an action directory during a Job
# pollutes every Runner. The default "copy the tar.gz and extract" approach is the safe one.

# The base image finishes as app (UID 1001). After the USER root above, switch back to it, or the Agent runs as root.
USER app

# Do **not** add `RUN node --version` here: the toolchain cache is deliberately kept off PATH.
# /opt/hostedtoolcache/node/<version>/<arch>/bin is prepended by actions/setup-node inside the Job, per version,
# once it is found. During the image build node is not on PATH, so calling it fails with command not found.
# That does not mean the cache is broken. Putting this directory in ENV PATH would make that command pass, but it would pin every Job to one
# node version, which defeats the version selection this cache exists to serve. Whether the install worked is verified by the test -x above.
# The `node --version` in ../../runner-images/Dockerfile.node is a different case: there node is installed via apt into
# /usr/bin, which is already on PATH.
