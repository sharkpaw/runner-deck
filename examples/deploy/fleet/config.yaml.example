# Most switches are injected from .env (config loading overrides them with environment variables, see applyEnvOverrides in internal/config/config.go),
# Only put items here that have no corresponding environment variable: resources and items.
# Usage: mkdir -p config && cp config.yaml.example config/config.yaml
# The Manager rewrites this file when Runners are added or removed in the UI; the two items below are preserved.
server:
    port: 8080
    addr: 0.0.0.0
runners:
    base_path: /app/runners
    items: []

    # Strongly recommended: if unlimited, a single runaway Job (Gradle daemon, -j$(nproc) compile) can consume all machine memory,
    # and drag the Manager down with it. Allocate as "concurrent Runners × per-Runner limit ≈ 80% of machine resources".
    # Also applies to existing containers (enforced via docker update on start/stop).
    resources:
        cpus: "4"
        memory: 8g
        memory_swap: 8g      # Equal to memory disables swap
        pids_limit: 4096

    # For a project that needs its own toolchain image, override it per Runner here:
    # items:
    #   - name: android
    #     target_type: repo
    #     target: your-org/your-app
    #     labels: [android]
    #     container_image: local/android-runner:1
    #     job_docker_backend: none
