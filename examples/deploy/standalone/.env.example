# Single container: runner processes live inside the Manager container (container_mode=false).
# Usage: cp .env.example .env, edit, then docker compose up -d. run.sh is the docker run version.

MANAGER_IMAGE=ghcr.io/sharkpaw/runner-deck:v2.0.0

# Host address and port. The container side is SERVER_PORT; compose maps one onto the other.
MANAGER_PORT=127.0.0.1:8080
SERVER_PORT=8080
SERVER_ADDR=0.0.0.0

BASIC_AUTH_USER=admin
# Empty disables auth (GET /health never needs it). Required when exposed to the internet.
BASIC_AUTH_PASSWORD=

RUNNERS_BASE_PATH=/app/runners

# Needed when jobs use docker: the group that owns the mounted docker.sock.
#   getent group docker | cut -d: -f3
# The container runs as UID 1001; outside this group, docker in a job fails with permission denied.
DOCKER_GID=999

# Docker backend for jobs. By default jobs share the host daemon through its socket, so image
# layers and BuildKit cache are shared, and jobs get full control of that daemon.
# For DinD, uncomment the next line and start with docker compose --profile dind up -d.
# DOCKER_HOST=tcp://runner-dind:2375
