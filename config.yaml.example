# Example configuration. Copy it to config/config.yaml before editing.
#   mkdir -p config runners && cp config.yaml.example config/config.yaml
#
# Field reference: docs/guide.md, section 2
#
# Docker / docker-compose: set runners.base_path to /app/runners, matching the volume in the image.
#
# A full-container deployment can set CONTAINER_MODE, VOLUME_HOST_PATH, JOB_DOCKER_BACKEND and the
# rest from .env instead, so none of the commented fields below need to be filled in here.

server:
    port: 8080
    addr: 0.0.0.0
runners:
    # Running locally: ./runners — in Docker: /app/runners
    base_path: ./runners

    # Predefined runners. You can also add them from the web UI.
    items: []

    # In container mode, image and in-job Docker backend can be overridden per runner (empty falls
    # back to the global values below), so one machine can serve projects with different toolchains.
    # items:
    #   - name: droiddesk
    #     target_type: repo
    #     target: soulteary/droiddesk
    #     labels: [droiddesk]
    #     container_image: your-registry/droiddesk-runner:1   # Flutter + Android SDK preinstalled
    #     job_docker_backend: none                            # this project needs no Docker in jobs

    # Container mode: each runner runs in its own container. The Manager starts and stops them
    # through the host's Docker socket and shares their network.
    # With it on, the Manager must use the host Docker — do not set DOCKER_HOST=tcp://runner-dind:2375.
    # container_mode: true

    # Left empty, the runner image is derived from FLEET_IMAGE_TAG, else the default tag.
    # container_image: ghcr.io/sharkpaw/runner-deck:v2.1.0-runner
    # container_network: runner-net
    # agent_port: 8081

    # Docker inside jobs: dind (a DinD service), host-socket (mount the host socket), none.
    # job_docker_backend: dind   # default dind
    # dind_host: runner-dind     # only when job_docker_backend=dind

    # Only when job_docker_backend=host-socket: the host's docker group GID, added to runner
    # containers so jobs can reach the mounted docker.sock. Empty or 0 detects it from docker.sock.
    # docker_gid: 999

    # Required when the Manager itself runs in a container: the absolute path of the runners
    # directory **on the host**.
    # volume_host_path: /absolute/path/on/host/to/runners

    # Resource limits for runner containers in container mode; empty means unlimited. Setting them
    # is strongly recommended: unlimited, one runaway job (a Gradle daemon, say) can exhaust the
    # machine's memory and take the Manager down with it.
    # resources:
    #     cpus: "2"          # --cpus
    #     memory: 4g         # --memory
    #     memory_swap: 4g    # --memory-swap, needs memory set; equal to memory disables swap
    #     pids_limit: 512    # --pids-limit, -1 for unlimited
    # Changes reach existing containers too (applied with docker update on start); clearing a limit
    # needs the container rebuilt.
